{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/lint-config/packages/oxlint-config/wxt.json",
    "./node_modules/lint-config/packages/oxlint-plugin-naming/preset.json"
  ],
  "rules": {
    "naming/convention": [
      "error",
      {
        "presets": ["webextension-manifest", "webextension-messages"],
        "allowedNames": [
          {
            "reason": "YouTube's own property names on its page objects, read as YouTube spells them",
            "names": ["actionRouter_"]
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules/**",
    ".output/**",
    ".wxt/**",
    "build/**",
    "user-profiles/**",
    "patches/**",
    "dev-server/target/**",
    "tools/target/**",
    ".chrome-for-testing/**"
  ]
}
