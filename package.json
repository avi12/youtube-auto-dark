{
  "name": "youtube-auto-dark",
  "version": "0.0.1",
  "private": true,
  "description": "Makes YouTube's \"Use device theme\" switch live the moment your system goes light or dark",
  "homepage": "https://github.com/avi12/youtube-auto-dark",
  "bugs": "https://github.com/avi12/youtube-auto-dark/issues",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Avi",
    "url": "https://avi12.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi12/youtube-auto-dark.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "bun run devtool dev",
    "dev:firefox": "bun run devtool dev --firefox",
    "devtool": "cargo run --release --quiet --manifest-path tools/Cargo.toml --",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:opera": "wxt build -b opera",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:opera": "wxt zip -b opera",
    "compile": "tsrs --noEmit",
    "lint": "avi12-lint",
    "lint:fix": "avi12-lint --fix",
    "test": "vitest run",
    "dev-server:test": "cargo test --manifest-path dev-server/Cargo.toml",
    "tools:test": "cargo test --manifest-path tools/Cargo.toml",
    "fallow": "fallow audit --base HEAD",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "fallow": "3.48.0",
    "lint-config": "github:avi12/lint-config#v0.13.0",
    "oxfmt": "^0.80.0",
    "oxlint": "1.95.0",
    "postcss": "^8.5.33",
    "postcss-html": "^2.0.1",
    "stylelint": "^18.1.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte-eslint-parser": "1.12.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  },
  "packageManager": "bun@1.4.5",
  "patchedDependencies": {
    "zod@4.6.7": "patches/zod.patch"
  },
  "trustedDependencies": [
    "@ast-grep/cli",
    "esbuild",
    "spawn-sync"
  ]
}
