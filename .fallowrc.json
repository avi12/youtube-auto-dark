{
  "$schema": "./node_modules/fallow/schema.json",
  "extends": ["./node_modules/fallow-config-avi12/fallow.json"],
  "entry": ["src/entrypoints/*/index.html", "dev-server/assets/*.js", "tools/assets/*.mjs"],
  "ignoreUnresolvedImports": ["#imports"],
  "ignoreDependencies": ["fallow-config-avi12", "oxlint-config-avi12", "oxlint-plugin-naming", "oxfmt-config-avi12"],
  "health": {
    "maxCognitive": 30,
    "maxCrap": 10000
  },
  "rules": {
    "unused-enum-members": "warn"
  }
}
