{
  "$schema": "./node_modules/fallow/schema.json",
  "extends": ["./node_modules/fallow-config-avi12/fallow.json"],
  "entry": ["src/entrypoints/*.ts", "src/entrypoints/*/index.html", "scripts/dev/index.ts"],
  "ignoreUnresolvedImports": ["#imports"],
  "ignoreDependencies": [
    "avi12-lint",
    "eslint-config-avi12",
    "fallow-config-avi12",
    "oxlint-config-avi12",
    "oxlint-plugin-naming",
    "oxfmt-config-avi12",
    "stylelint-config-avi12",
    "postcss-html"
  ],
  "health": { "maxCognitive": 30, "maxCrap": 10000 },
  "rules": { "unused-enum-members": "warn" }
}
