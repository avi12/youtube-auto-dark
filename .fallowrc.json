{
  "$schema": "./node_modules/fallow/schema.json",
  "extends": ["./node_modules/lint-config/packages/fallow-config/fallow.json"],
  "entry": ["src/entrypoints/*/index.html", "dev-server/assets/*.js", "tools/assets/*.mjs"],
  "ignoreUnresolvedImports": ["#imports"],
  "ignoreDependencies": ["lint-config", "stylelint-config-ccb", "typescript-eslint", "globals"],
  "health": {
    "maxCognitive": 30,
    "maxCrap": 10000
  },
  "rules": {
    "unused-enum-members": "warn"
  }
}
